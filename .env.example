# Copy this file to .env and fill in your values. Never commit .env itself.

# ---- Provider --------------------------------------------------------------
# Nebius Token Factory API key (leave blank while in mock mode)
NEBIUS_API_KEY=

# OpenAI-compatible endpoint. Verified against docs.tokenfactory.nebius.com.
# (api.studio.nebius.* is the older "AI Studio" host.)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model ids from the Nebius token-factory-cookbook Nemotron page. Confirm them
# with your own key before a live run:   python -m training.check_provider
NANO_MODEL=nvidia/nvidia-nemotron-3-nano-30b-a3b
ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Served names of fine-tuned + DEPLOYED models (see docs/DEPLOYMENT.md). Blank = use base.
FINE_TUNED_NANO_MODEL=
FINE_TUNED_ULTRA_MODEL=

# ---- Mode ------------------------------------------------------------------
# 1 = MOCK: seeded local fake model, no network, no cost (default; safe).
# 0 = LIVE: real Token Factory calls (needs NEBIUS_API_KEY; costs money).
USE_FAKE_MODEL=1

# Log every live call (prompt + response) to data/training/calls.jsonl.
LOG_TRAINING_DATA=1

# ---- Model call bounds -------------------------------------------------------
# Nemotron 3 models are reasoning models: a too-small token budget returns EMPTY
# content. Validate with check_provider before a live run.
MODEL_MAX_TOKENS=1024
MODEL_TIMEOUT_SECONDS=20
MODEL_MAX_RETRIES=3
MODEL_DEADLINE_SECONDS=60

# ---- Agent strategies ------------------------------------------------------------
# roster   = each personality plays the strategy that matches it (default)
# baseline = no policy gating (the control group for experiments)
# or a single strategy name for everyone, or a comma list, one name per agent:
#   conservative | aggressive | cost_efficient | accuracy_focused | lender
STRATEGY_SET=roster

# ---- Optional: turn provider-reported tokens into an ESTIMATED cost -------------
# USD per 1M tokens, copied by YOU from Nebius's pricing page. Unset = cost shown as "unknown"
# (never a guess). Simulated compute-seconds are a separate, in-game currency.
NANO_PRICE_IN_PER_MTOK=
NANO_PRICE_OUT_PER_MTOK=
ULTRA_PRICE_IN_PER_MTOK=
ULTRA_PRICE_OUT_PER_MTOK=

# ---- Reproducibility ---------------------------------------------------------
# Fixed seed => same task sequence and (in mock mode) same behaviour. Blank = random per run.
SIMULATION_SEED=

# ---- Server / security ---------------------------------------------------------
HOST=127.0.0.1
PORT=5000
# PUBLIC_MODE=1 fails CLOSED: /control/* is disabled (403) unless CONTROL_TOKEN is set.
PUBLIC_MODE=0
# When set, /control/* requires header  X-Control-Token: <value>.  Use a long random value.
CONTROL_TOKEN=
# Extra origins allowed to POST (comma-separated), e.g. https://demo.example.com. Cross-origin POSTs are refused.
ALLOWED_ORIGINS=
AUTH_FAIL_MAX_PER_MINUTE=10
READ_MAX_PER_MINUTE=600
# Set to 1 ONLY behind a trusted reverse proxy (uses X-Forwarded-For for rate limiting).
TRUST_PROXY=0

# "Ask the economy" limits (live mode spends real model calls per question).
ENABLE_INJECT=1
INJECT_MAX_PER_MINUTE_PER_IP=5
INJECT_MAX_PER_HOUR_GLOBAL=60
INJECT_MAX_PENDING=10
MAX_REQUEST_BYTES=16384
